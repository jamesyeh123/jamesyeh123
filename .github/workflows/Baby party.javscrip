// 遊戲狀態
let gameState = {
    isHost: false,
    gameCode: '',
    hostName: '',
    babyName: '',
    participants: [],
    votes: { boy: 0, girl: 0 },
    playerVotes: {},
    currentPlayer: '',
    revealed: false,
    actualGender: null
};

// 生成邀請碼
function generateInviteCode() {
    return Math.random().toString(36).substr(2, 6).toUpperCase();
}

// 顯示指定區塊
function showSection(sectionId) {
    document.querySelectorAll('.section').forEach(section => {
        section.classList.remove('active');
    });
    document.getElementById(sectionId).classList.add('active');
}

// 建立遊戲
function createGame() {
    showSection('create-section');
}

// 顯示加入遊戲
function showJoinGame() {
    showSection('join-section');
}

// 返回首頁
function goBack() {
    showSection('start-section');
}

// 開始遊戲
function startGame() {
    const hostName = document.getElementById('hostName').value.trim();
    const babyName = document.getElementById('babyName').value.trim();
    
    if (!hostName || !babyName) {
        alert('請填寫所有必要資訊！');
        return;
    }
    
    gameState.isHost = true;
    gameState.hostName = hostName;
    gameState.babyName = babyName;
    gameState.gameCode = generateInviteCode();
    gameState.currentPlayer = hostName;
    gameState.participants = [{ name: hostName, vote: null, isHost: true }];
    
    updateGameDisplay();
    showSection('game-section');
}

// 加入遊戲
function joinGame() {
    const playerName = document.getElementById('playerName').value.trim();
    const inviteCode = document.getElementById('inviteCode').value.trim().toUpperCase();
    
    if (!playerName || !inviteCode) {
        alert('請填寫所有必要資訊！');
        return;
    }
    
    if (inviteCode.length === 6) {
        gameState.currentPlayer = playerName;
        gameState.gameCode = inviteCode;
        
        const existingPlayer = gameState.participants.find(p => p.name === playerName);
        if (!existingPlayer) {
            gameState.participants.push({ name: playerName, vote: null, isHost: false });
        }
        
        updateGameDisplay();
        showSection('game-section');
    } else {
        alert('邀請碼格式不正確！');
    }
}

// 投票
function vote(gender) {
    if (gameState.playerVotes[gameState.currentPlayer]) {
        const oldVote = gameState.playerVotes[gameState.currentPlayer];
        gameState.votes[oldVote]--;
    }
    
    gameState.playerVotes[gameState.currentPlayer] = gender;
    gameState.votes[gender]++;
    
    const participant = gameState.participants.find(p => p.name === gameState.currentPlayer);
    if (participant) {
        participant.vote = gender;
    }
    
    updateGameDisplay();
    
    if (gameState.isHost && Object.keys(gameState.playerVotes).length > 0) {
        document.getElementById('revealBtn').style.display = 'inline-block';
    }
}

// 更新遊戲顯示
function updateGameDisplay() {
    document.getElementById('displayBabyName').textContent = gameState.babyName || '寶寶';
    document.getElementById('gameCode').textContent = gameState.gameCode;
    document.getElementById('boyVotes').textContent = gameState.votes.boy;
    document.getElementById('girlVotes').textContent = gameState.votes.girl;
    document.getElementById('participantCount').textContent = gameState.participants.length;
    
    const participantsList = document.getElementById('participantsList');
    participantsList.innerHTML = '';
    
    gameState.participants.forEach(participant => {
        const div = document.createElement('div');
        div.className = 'participant';
        
        const voteDisplay = participant.vote ? 
            (participant.vote === 'boy' ? '👶' : '👧') : '⏳';
        const hostLabel = participant.isHost ? ' (主辦人)' : '';
        
        div.innerHTML = `
            <span>${participant.name}${hostLabel}</span>
            <span>${voteDisplay}</span>
        `;
        participantsList.appendChild(div);
    });
}

// 揭曉性別
function revealGender() {
    if (!gameState.isHost) {
        alert('只有主辦人可以揭曉答案！');
        return;
    }
    
    const genders = ['boy', 'girl'];
    gameState.actualGender = genders[Math.floor(Math.random() * 2)];
    
    showResult();
}

// 顯示結果
function showResult() {
    const resultEmoji = document.getElementById('resultEmoji');
    const resultText = document.getElementById('resultText');
    const winnersList = document.getElementById('winnersList');
    
    if (gameState.actualGender === 'boy') {
        resultEmoji.textContent = '👶';
        resultText.textContent = `恭喜！${gameState.babyName} 是個男孩！`;
    } else {
        resultEmoji.textContent = '👧';
        resultText.textContent = `恭喜！${gameState.babyName} 是個女孩！`;
    }
    
    const winners = gameState.participants.filter(p => 
        p.vote === gameState.actualGender
    );
    
    winnersList.innerHTML = '';
    if (winners.length > 0) {
        winners.forEach(winner => {
            const div = document.createElement('div');
            div.textContent = `🎉 ${winner.name}`;
            div.style.margin = '0.5rem 0';
            div.style.color = '#ff6b9d';
            div.style.fontWeight = 'bold';
            winnersList.appendChild(div);
        });
    } else {
        winnersList.innerHTML = '<p>沒有人猜對呢！</p>';
    }
    
    createConfetti();
    showSection('result-section');
}

// 創建紙屑效果
function createConfetti() {
    for (let i = 0; i < 50; i++) {
        setTimeout(() => {
            const confetti = document.createElement('div');
            confetti.className = 'confetti';
            confetti.style.left = Math.random() * 100 + '%';
            confetti.style.backgroundColor = ['#ff6b9d', '#4ecdc4', '#ffd700', '#74b9ff'][Math.floor(Math.random() * 4)];
            confetti.style.animationDelay = Math.random() * 3 + 's';
            confetti.style.animationDuration = (Math.random() * 3 + 2) + 's';
            document.body.appendChild(confetti);
            
            setTimeout(() => {
                confetti.remove();
            }, 5000);
        }, i * 100);
    }
}

// 重置遊戲
function resetGame() {
    gameState = {
        isHost: false,
        gameCode: '',
        hostName: '',
        babyName: '',
        participants: [],
        votes: { boy: 0, girl: 0 },
        playerVotes: {},
        currentPlayer: '',
        revealed: false,
        actualGender: null
    };
    
    document.querySelectorAll('input').forEach(input => input.value = '');
    
    showSection('start-section');
}
